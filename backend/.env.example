# Copy to .env and fill in ONE provider. Never commit the real .env.
# The server reads this once at startup -- RESTART after editing.

# =========================================================================
# OPTION A: Google Gemini (recommended -- has a free tier)
# =========================================================================
# Get a key at https://aistudio.google.com/apikey  (keys start with "AIza")
GEMINI_API_KEY=

# gemini-3.6-flash is fast and cheap and handles this task well.
GEMINI_MODEL=gemini-3.6-flash

# =========================================================================
# OPTION B: Azure OpenAI
# =========================================================================
# Endpoint looks like: https://your-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The DEPLOYMENT name you chose in Azure AI Foundry, NOT the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# =========================================================================
# Options
# =========================================================================
# auto (default) picks whichever key is present, preferring Gemini.
# Force one with: gemini | azure
GREENSWAP_PROVIDER=auto

# The research agent with citations. Set to "off" for a single cheaper call.
GREENSWAP_AGENT=on

# Seconds before giving up on a model call.
LLM_TIMEOUT=20

# --- Supabase (optional) -------------------------------------------------
# Leave blank to run on the built-in demo catalog with an in-memory cache.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Product search fallback (optional) ----------------------------------
# Used only when the browser cannot scrape the retailer itself.
# Free tier: 100 requests/month, no card. https://www.canopyapi.co/
CANOPY_API_KEY=

# Copy to .env and fill in. Never commit the real .env.

# --- Azure OpenAI (material inference) ---
# Endpoint looks like: https://<your-resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# This is the DEPLOYMENT name you chose in Azure AI Foundry, not the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Supabase (certified data + estimate cache) ---
# Leave blank to run entirely on the built-in demo catalog.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Seconds before giving up on a model call (default 20).
AZURE_OPENAI_TIMEOUT=20
